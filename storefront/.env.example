# Chép file này thành .env.local rồi điền giá trị (ERP > Website > Kết nối website)
# Địa chỉ backend MyERP
ERP_API_URL=http://localhost:5121
# Khóa API của website (chỉ hiện 1 lần lúc tạo) - KHÔNG đưa lên git, KHÔNG dùng ở phía trình duyệt
ERP_SITE_KEY=
# Mật khẩu webhook: ERP gửi kèm khi báo website làm mới (header x-revalidate-secret)
REVALIDATE_SECRET=
